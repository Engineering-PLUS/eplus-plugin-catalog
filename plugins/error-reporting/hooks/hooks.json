{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}\\scripts\\note-identity.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__error-reporting__report_issue|mcp__error-reporting__request_egress_allow|mcp__plugin_error-reporting_error-reporting__report_issue|mcp__plugin_error-reporting_error-reporting__request_egress_allow",
        "hooks": [
          {
            "type": "command",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}\\scripts\\stamp-identity.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__workspace__web_fetch",
        "hooks": [
          {
            "type": "command",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}\\scripts\\egress-after-fetch.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}\\scripts\\report-tool-failure.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
