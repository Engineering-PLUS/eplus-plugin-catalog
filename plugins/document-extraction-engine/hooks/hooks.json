{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__analyze_document$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/upload_document.py\"",
            "timeout": 120,
            "statusMessage": "Uploading document to the Document Analysis engine..."
          }
        ]
      }
    ]
  }
}
